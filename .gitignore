.DS_Store
node_modules/

# Source audio. These are licensed Splice masters, 96 kHz and hundreds of
# megabytes, and this repo is public on two counts that both matter: the licence
# does not permit redistributing the raw samples, and git keeps every version of
# a binary forever. Only the encoded, trimmed derivatives are committed.
audio/source/
*.wav
*.aif
*.aiff

# the Ocean Cavern master lives with the other sources, ignored with them
audio/source/Ocean_Cavern.wav

# the mirror test's local relay password (tools/mirror-local.mjs)
.mirror-key

# the TSC 2026 show's slide videos (core/schema-slides.js), copied locally,
# never committed: on the site they stream from R2 through
# functions/slides/[[path]].js. Only the root's slides/ (so that Function's
# own folder is not caught); the QR image and the controller's 144p cue
# previews are small, immutable and committed by name (git add -f), as the
# standalone presentation site carries them.
/slides/

# the Sun's videos (gpu/sun.js), copied locally for localhost shows, never committed
sun-video/

# headless Chrome profiles and screenshots of tools/gap-explorer-check.mjs
tools/.headless-profiles/

# per-file logs of tools/heart-tests/run-each.sh
tools/heart-tests/logs/
__pycache__/
